import { ref } from 'vue'

let count = ref(0)

div(class="ovs-card") {
  h2 { "Rendered from .ovs" }
  p { "OVS component compiled by Vite plugin." }
  p {
    "OVS count: "
    count.value
  }
  button(
    class="ovs-button",
    onClick() {
      count.value++
    }
  ) {
    "Increment OVS"
  }
}
