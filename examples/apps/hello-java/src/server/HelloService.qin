import { Service as S } from "java:org.springframework.stereotype"

@S
class HelloService {
  prefix: string = "hello "

  message() {
    return this.prefix + "from qin service"
  }

  normalize(name: string) {
    return name.trim()
  }

  greet(name: string) {
    const normalized = this.normalize(name)
    return this.prefix + normalized
  }

  shout(text: string) {
    return text.toUpperCase()
  }

  greetLoud(name: string) {
    return this.shout(this.greet(name))
  }
}
