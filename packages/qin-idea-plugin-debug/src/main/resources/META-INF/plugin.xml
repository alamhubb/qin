<idea-plugin>
    <id>com.qin.idea</id>
    <name>Qin Build Tool</name>
    <version>0.1.1</version>
    <vendor>Qin</vendor>

    <description>Qin IDEA integration: sync/compile diagnostics without custom run override.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.qin.debug.DebugStartup"/>
        <toolWindow id="Qin" anchor="right" factoryClass="com.qin.debug.QinToolWindowFactory"/>
        <notificationGroup id="Qin Notifications" displayType="BALLOON" toolWindowId="Qin"/>

        <consoleFilterProvider implementation="com.qin.debug.console.QinConsoleFilterProvider"/>
        <externalAnnotator language="JAVA" implementationClass="com.qin.debug.annotator.QinExternalAnnotator"/>
        <projectService serviceImplementation="com.qin.debug.annotator.QinCompileErrorService"/>

        <fileType
                name="Qin Source"
                implementationClass="com.qin.debug.lsp.QinLspFileType"
                fieldName="INSTANCE"
                extensions="qin"/>
        <fileType
                name="OVS Source"
                implementationClass="com.qin.debug.lsp.OvsLspFileType"
                fieldName="INSTANCE"
                extensions="ovs"/>
        <fileType
                name="CSSTS Source"
                implementationClass="com.qin.debug.lsp.CsstsLspFileType"
                fieldName="INSTANCE"
                extensions="cssts"/>
        <platform.lsp.serverSupportProvider implementation="com.qin.debug.lsp.QinLspServerSupportProvider"/>

        <!-- Keep IDEA native Java Run/Debug; do not inject Qin run configuration. -->
    </extensions>
</idea-plugin>
