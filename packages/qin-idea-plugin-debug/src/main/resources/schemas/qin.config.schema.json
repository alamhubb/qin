{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qin Configuration",
  "description": "Qin 椤圭洰閰嶇疆鏂囦欢 (qin.config.js)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "椤圭洰鍚嶇О锛屾牸寮? groupId:artifactId",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*:[a-zA-Z][a-zA-Z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "description": "椤圭洰鐗堟湰鍙?,
      "default": "1.0.0"
    },
    "description": {
      "type": "string",
      "description": "椤圭洰鎻忚堪"
    },
    "entry": {
      "type": "string",
      "description": "鍏ュ彛绫荤殑瀹屽叏闄愬畾鍚嶆垨鏂囦欢璺緞"
    },
    "java": {
      "type": "object",
      "description": "Java 缂栬瘧閰嶇疆",
      "properties": {
        "version": {
          "type": "string",
          "description": "Java 鐗堟湰",
          "enum": ["8", "11", "17", "21", "23", "25"],
          "default": "21"
        },
        "source": {
          "type": "string",
          "description": "婧愮爜鍏煎鐗堟湰"
        },
        "target": {
          "type": "string",
          "description": "鐩爣瀛楄妭鐮佺増鏈?
        },
        "sourceDir": {
          "type": "string",
          "description": "婧愮爜鐩綍",
          "default": "src/main/java"
        },
        "testDir": {
          "type": "string",
          "description": "娴嬭瘯婧愮爜鐩綍",
          "default": "src/test/java"
        },
        "outputDir": {
          "type": "string",
          "description": "缂栬瘧杈撳嚭鐩綍",
          "default": "build/classes"
        },
        "encoding": {
          "type": "string",
          "description": "婧愭枃浠剁紪鐮?,
          "default": "UTF-8"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "椤圭洰渚濊禆锛屾牸寮? { \"groupId:artifactId\": \"version\" }",
      "additionalProperties": {
        "type": "string",
        "description": "渚濊禆鐗堟湰鍙?
      }
    },
    "devDependencies": {
      "type": "object",
      "description": "寮€鍙戜緷璧?,
      "additionalProperties": {
        "type": "string"
      }
    },
    "output": {
      "type": "object",
      "description": "鎵撳寘杈撳嚭閰嶇疆",
      "properties": {
        "dir": {
          "type": "string",
          "description": "杈撳嚭鐩綍",
          "default": "dist"
        },
        "jarName": {
          "type": "string",
          "description": "JAR 鏂囦欢鍚?
        },
        "fatJar": {
          "type": "boolean",
          "description": "鏄惁鎵撳寘涓?Fat JAR",
          "default": false
        }
      }
    },
    "repositories": {
      "type": "array",
      "description": "Maven 浠撳簱閰嶇疆",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "浠撳簱 ID"
          },
          "url": {
            "type": "string",
            "description": "浠撳簱 URL",
            "format": "uri"
          }
        },
        "required": ["url"]
      }
    },
    "plugins": {
      "type": "array",
      "description": "Qin 鎻掍欢鍒楄〃",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["name"]
}

